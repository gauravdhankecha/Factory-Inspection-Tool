# MongoDB Atlas અથવા Local MongoDB Connection String
# ઉદાહરણ (Atlas): mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/inspection_db?retryWrites=true&w=majority
# ઉદાહરણ (Local): mongodb://127.0.0.1:27017/inspection_db
MONGODB_URI=

# Any long random text (at least 32 characters). Keeps logins safe — never share it.
AUTH_SECRET=

# Optional: switches on "photo → form" (AI reading of the field-form photos).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
